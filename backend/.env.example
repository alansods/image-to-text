# Para rodar a API e o worker fora do Docker (README, "Mais rápido no Mac"): copie para .env.
# No Docker, as variáveis do docker-compose.yml têm prioridade.
# Origens do frontend autorizadas (JSON)
ITT_CORS_ORIGINS=["http://localhost:3000"]
ITT_REDIS_URL=redis://localhost:6379/0
ITT_DATA_DIR=/tmp/itt-jobs
