{
  "$defs": {
    "JobStage": {
      "description": "Etapa real da conversão, mostrada na tela de progresso (spec job-processing).",
      "enum": [
        "queued",
        "preparing",
        "layout",
        "reading",
        "finishing"
      ],
      "title": "JobStage",
      "type": "string"
    },
    "JobState": {
      "enum": [
        "queued",
        "processing",
        "done",
        "failed",
        "cancelled",
        "expired"
      ],
      "title": "JobState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/JobState",
      "default": "queued"
    },
    "progress": {
      "default": 0,
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/JobStage",
      "default": "queued"
    },
    "page": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "pages": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "source_file",
    "created_at",
    "state",
    "progress",
    "stage",
    "page",
    "pages",
    "error"
  ],
  "title": "Job",
  "type": "object"
}
